<?xml version="1.0" encoding="utf-8"?>
<!-- Hanzi Path on the phone: the web app (index.html, app.js, data/) in a WebView, its
     files from the APK's assets or from a newer copy the updater downloaded, progress in
     SQLite (Db), the readings spoken by Android's own voice (Speech). The updater asks
     GitHub's latest release at most every few hours: a new web copy is used at once, a new
     APK installs over this one (silently once this app installed itself). versionCode is
     set by assemble (the commits that touched android/). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.stefanofrigerio.hanzipath">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/icon"
        android:label="汉字之路"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup"
        android:dataExtractionRules="@xml/extraction"
        android:theme="@style/Paper">
        <activity
            android:name=".Main"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".Installed" android:exported="false" />
    </application>
</manifest>
