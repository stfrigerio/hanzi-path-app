<?xml version="1.0" encoding="utf-8"?>
<!-- Hanzi Path: native screens built in code (Main and the screens it opens), the path and
     its strokes in the assets (made by tools/build.py), progress in SQLite (Progress), the
     readings spoken by Android's own voice (Speech). The one notification is the daily
     reminder (Reminder: an inexact alarm, armed again after a reboot or an update). The
     home-screen widget (Widget) shows what's due and a character from the path. versionCode
     is set by assemble: the commits on the branch. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.stefanofrigerio.hanzipath">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/icon"
        android:label="汉字之路"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup"
        android:dataExtractionRules="@xml/extraction"
        android:theme="@style/Paper"
        android:supportsRtl="false">
        <activity
            android:name=".Main"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".Reminder" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".Widget" android:exported="true" android:label="汉字之路">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget" />
        </receiver>
    </application>
</manifest>
